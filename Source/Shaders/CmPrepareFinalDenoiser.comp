#version 460

// The same as CmPrepareFinal, but for an external temporal denoiser (MetalFX temporal denoised scaler):
// what is already noise-free (rasterized geometry, volumetrics, screen emission) is not in the image to denoise,
// but in a transparency overlay that the denoiser puts on top: rgb + ( 1 - a ) * denoised.

#define DESC_SET_FRAMEBUFFERS 0
#define DESC_SET_GLOBAL_UNIFORM 1
#define DESC_SET_TONEMAPPING 2
#include "ShaderCommonGLSLFunc.h"
#include "Exposure.h"

layout( local_size_x = COMPUTE_COMPOSE_GROUP_SIZE_X, local_size_y = COMPUTE_COMPOSE_GROUP_SIZE_Y, local_size_z = 1 ) in;

layout( set = 4, binding = 0, rgba16f ) uniform writeonly image2D denoiserOverlay;
// MetalRasterizer::DrawToFinal 'asOverlay': premultiplied color, the coverage in alpha
layout( set = 4, binding = 1, rgba16f ) uniform readonly image2D denoiserRasterOverlay;

void main()
{
    const ivec2 pix = ivec2( gl_GlobalInvocationID.x, gl_GlobalInvocationID.y );
    if( pix.x >= uint( globalUniform.renderWidth ) || pix.y >= uint( globalUniform.renderHeight ) )
    {
        return;
    }

    vec3 hdr = texelFetch( framebufFinal_Sampler, pix, 0 ).rgb;

    // CmPrepareFinal does ( ( raster + ( 1 - rasterCoverage ) * hdr ) * volumetric.a + volumetric.rgb ) * exposure,
    // and the denoiser gets hdr * exposure, so the rest is the overlay
    const vec4 raster = imageLoad( denoiserRasterOverlay, pix );

    vec3  overlay  = raster.rgb;
    float coverage = raster.a;

    if( !classicShading( pix ) )
    {
        const float exposure = ev100ToLuminousExposure( getCurrentEV100() );

        // volumetrics: hdr * a + rgb, so the overlay is rgb with the opacity of ( 1 - a )
        const vec4 volumetric = texelFetch( framebufScattering_Sampler, pix, 0 );

        hdr      = hdr * exposure;
        overlay  = ( raster.rgb * volumetric.a + volumetric.rgb ) * exposure;
        coverage = 1.0 - ( 1.0 - raster.a ) * volumetric.a;
    }

    // screen emissive
    {
        const vec3 screenEmis = texelFetch( framebufScreenEmission_Sampler, pix, 0 ).rgb;
        overlay += screenEmis * globalUniform.emissionMaxScreenColor;
    }

    imageStore( framebufFinal, pix, vec4( hdr, 0 ) );
    imageStore( denoiserOverlay, pix, vec4( max( overlay, vec3( 0.0 ) ), clamp( coverage, 0.0, 1.0 ) ) );
}
