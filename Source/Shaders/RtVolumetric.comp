#version 460

#define MATERIAL_MAX_ALBEDO_LAYERS 0

#define DESC_SET_TLAS           0
#define DESC_SET_FRAMEBUFFERS   1
#define DESC_SET_GLOBAL_UNIFORM 2
#define DESC_SET_VERTEX_DATA    3
#define DESC_SET_TEXTURES       4
#define DESC_SET_RANDOM         5
#define DESC_SET_LIGHT_SOURCES  6
#define DESC_SET_CUBEMAPS       7
#define DESC_SET_RENDER_CUBEMAP 8
#define DESC_SET_VOLUMETRIC     11
#define LIGHT_SAMPLE_METHOD     ( LIGHT_SAMPLE_METHOD_VOLUME )
#include "RaygenCommon.h"
#include "Volumetric.h"

// Approximation of Henyey-Greenstein's phase function
float phaseFunction_Schlick( const vec3 tolight, const vec3 toviewer, float assymetry )
{
    float costheta = dot( tolight, toviewer );
    float k        = 1.55 * assymetry - 0.55 * assymetry * assymetry * assymetry;

    return ( 1 - square( k ) ) / ( 4 * M_PI * square( 1 + k * costheta ) );
}

// ---- smoke clouds (globalUniform.smokeSpheres / smokeParams)

float smoke_hash( vec3 p )
{
    p = fract( p * 0.1031 );
    p += dot( p, p.zyx + 31.32 );
    return fract( ( p.x + p.y ) * p.z );
}

float smoke_noise( vec3 p )
{
    const vec3 i = floor( p );
    vec3       f = fract( p );
    f            = f * f * ( 3.0 - 2.0 * f );

    return mix( mix( mix( smoke_hash( i + vec3( 0, 0, 0 ) ), smoke_hash( i + vec3( 1, 0, 0 ) ), f.x ),
                     mix( smoke_hash( i + vec3( 0, 1, 0 ) ), smoke_hash( i + vec3( 1, 1, 0 ) ), f.x ),
                     f.y ),
                mix( mix( smoke_hash( i + vec3( 0, 0, 1 ) ), smoke_hash( i + vec3( 1, 0, 1 ) ), f.x ),
                     mix( smoke_hash( i + vec3( 0, 1, 1 ) ), smoke_hash( i + vec3( 1, 1, 1 ) ), f.x ),
                     f.y ),
                f.z );
}

// 0..~0.9
float smoke_fbm( vec3 p )
{
    return 0.5 * smoke_noise( p ) + 0.25 * smoke_noise( p * 2.03 + 17.1 ) +
           0.125 * smoke_noise( p * 4.01 + 31.7 );
}

// x - extinction, y - glow, z - scattering (extinction times each cloud's albedo), at a world position
vec3 smokeAt( const vec3 pos )
{
    float ext  = 0.0;
    float glow = 0.0;
    float scat = 0.0;

    for( uint i = 0; i < min( globalUniform.smokeCount, MAX_SMOKE_VOLUMES ); i++ )
    {
        const vec4  sp   = globalUniform.smokeSpheres[ i ];
        const vec4  prm  = globalUniform.smokeParams[ i ];
        const vec3  d    = pos - sp.xyz;
        const float dist = length( d );

        if( dist >= sp.w )
        {
            continue;
        }

        const float age = prm.y;
        // turbulence: drifts upwards and swirls slowly over time (in world z, Quake's up)
        vec3 q = d / ( sp.w * 0.45 ) + vec3( prm.z, prm.z * 1.7, -age * 0.35 );
        q.xy += vec2( sin( age * 0.7 + q.z * 1.3 ), cos( age * 0.6 + q.x * 1.1 ) ) * 0.35;

        const float n = smoke_fbm( q );
        const float x = dist / sp.w;

        // round, with wispy edges and a denser core
        const float shape = clamp( 1.0 - x * x, 0.0, 1.0 );
        const float dens  = shape * smoothstep( 0.25, 0.65, n + 0.35 * ( 1.0 - x ) );

        ext += prm.x * dens;
        glow += prm.w * dens;
        scat += prm.x * dens * clamp( globalUniform.smokeExtra[ i ].x, 0.0, 1.0 );
    }

    return vec3( ext, glow, scat );
}

void main()
{
    RAYGEN_RETURN_IF_OUTSIDE( VOLUMETRIC_SIZE_X, VOLUMETRIC_SIZE_Y, VOLUMETRIC_SIZE_Z );
    const ivec3 cell = ivec3( gl_GlobalInvocationID.xyz );

    if( globalUniform.volumeEnableType != VOLUME_ENABLE_VOLUMETRIC )
    {
        imageStore( g_volumetric, cell, vec4( 0.0 ) );
#if ILLUMINATION_VOLUME
        imageStore( g_illuminationVolume, cell, vec4( 0.0 ) );
#endif
        return;
    }

    vec3       center   = volume_getCenter( cell );
    const vec3 toviewer = normalize( globalUniform.cameraPosition.xyz - center );

    {
        vec3  s      = volume_getCenter( cell + ivec3( 0, 0, 1 ) );
        vec3  radius = ( center - s ) * 0.5;
        uint  seed   = getRandomSeed( cell.xy, globalUniform.frameId );
        float rnd    = rndBlueNoise8( seed, 0 ).x * 2 - 1;
        center += radius * rnd;
    }

// Skip the cells that no pixel looks through: those beyond the whole path of the pixel
// at the cell's center (its distance along the reflected / refracted path for water and
// glass, which read the fog past the surface), with a margin of a few cells for the
// interpolated and dithered sampling. Not behind dynamic geometry (e.g. the weapon), as
// what's behind it can be seen next to it.
    {
        const vec4 clip = globalUniform.projection * globalUniform.view * vec4( volume_getCenter( cell ), 1.0 );
        if( clip.w > 0.0 )
        {
            const vec2  uv  = clip.xy / clip.w * 0.5 + 0.5;
            const ivec2 pix = ivec2( uv * vec2( globalUniform.renderWidth, globalUniform.renderHeight ) );

            // the cell covers a patch of pixels: the farthest path in it (center and corners)
            const ivec2 rsize = ivec2( globalUniform.renderWidth, globalUniform.renderHeight );
            const ivec2 hcell  = max( rsize / ivec2( VOLUMETRIC_SIZE_X, VOLUMETRIC_SIZE_Y ) / 2, ivec2( 1 ) );
            const ivec2 offs[ 5 ] = { ivec2( 0, 0 ),
                                      ivec2( -hcell.x, -hcell.y ),
                                      ivec2( hcell.x, -hcell.y ),
                                      ivec2( -hcell.x, hcell.y ),
                                      ivec2( hcell.x, hcell.y ) };

            float pathLength = 0.0;
            bool  onScreen   = false;
            bool  dynamic    = false;
            for( int i = 0; i < 5; i++ )
            {
                const ivec2 p = pix + offs[ i ];
                if( any( lessThan( p, ivec2( 0 ) ) ) || any( greaterThanEqual( p, rsize ) ) )
                {
                    continue;
                }
                const ivec2 chpix = getCheckerboardPix( p );
                const uint  instCustomIndex =
                    floatBitsToUint( texelFetch( framebufSurfacePosition_Sampler, chpix, 0 ).a );

                onScreen   = true;
                dynamic    = dynamic || ( instCustomIndex & INSTANCE_CUSTOM_INDEX_FLAG_DYNAMIC ) != 0;
                pathLength = max( pathLength, texelFetch( framebufDepthWorld_Sampler, chpix, 0 ).r );
            }

            const float marginCellDist = length(
                volume_getCenter( max( cell - ivec3( 0, 0, 3 ), ivec3( 0 ) ) ) - globalUniform.cameraPosition.xyz );

            if( onScreen && !dynamic && marginCellDist > pathLength )
            {
                imageStore( g_volumetric, cell, vec4( 0.0 ) );
#if ILLUMINATION_VOLUME
                imageStore( g_illuminationVolume, cell, vec4( 0.0 ) );
#endif
                return;
            }
        }
    }

    vec3 lighting = globalUniform.volumeAmbient.rgb;
    vec3 radiance = vec3( 0.0 );

#if SHIPPING_HACK
    if( getLuminance( globalUniform.volumeSourceColor.rgb ) > 0.01 )
    {
        bool isShadowed = traceShadowRay(
            0, center, center + MAX_RAY_LENGTH * globalUniform.volumeDirToSource.xyz, true );

        radiance += globalUniform.volumeSourceColor.rgb * float( !isShadowed );
        lighting += radiance * phaseFunction_Schlick( globalUniform.volumeDirToSource.xyz,
                                                      toviewer,
                                                      globalUniform.volumeSourceAsymmetry );
    }
#else
    if( globalUniform.directionalLightExists != 0 )
    {
        DirectionalLight l =
            decodeAsDirectionalLight( lightSources[ LIGHT_ARRAY_DIRECTIONAL_LIGHT_OFFSET ] );
        bool isShadowed = traceShadowRay( 0, center, center - MAX_RAY_LENGTH * l.direction, true );

        radiance += l.color * float( !isShadowed );
        lighting += radiance * phaseFunction_Schlick( -l.direction, toviewer, 0.4 );
    }
#endif

#if ILLUMINATION_VOLUME
    {
        vec3 radiance_Prev = imageLoad( g_illuminationVolume, cell ).rgb;
        if( any( isnan( radiance_Prev ) ) || any( isinf( radiance_Prev ) ) )
        {
            radiance_Prev = vec3( 0 );
        }

        uint seed = getRandomSeed( ivec2( cell.x + cell.z, cell.y + 19 * cell.z ), globalUniform.frameId );

        // TODO: processDirectIllumination without normals
        vec3 n = safeNormalize( toviewer );

        Surface s;
        {
            s.position        = center;
            s.instCustomIndex = 0;
            s.normalGeom      = n;
            s.roughness       = 1.0;
            s.normal          = n;
            s.albedo          = vec3( 1.0 );
            s.isSky           = false;
            s.specularColor   = vec3( 0.04 );
            s.emission        = 0.0;
            s.toViewerDir     = toviewer;
        }

        vec3 tolight = vec3( 0, 1, 0 );

        radiance += processDirectIllumination( seed, s, 0, tolight );

        radiance = mix( radiance_Prev, radiance, 0.05 );
        lighting += radiance * phaseFunction_Schlick( tolight, toviewer, 0.4 );
    }
#endif


    float scattering = globalUniform.volumeScattering * 0.001;
    float absorbtion = 0.0;

    // smoke: extinction, part of it scattering the same light as the fog
    vec3 emission = vec3( 0.0 );
    if( globalUniform.smokeCount > 0 )
    {
        const vec3 sm = smokeAt( center );

        scattering += sm.z;
        absorbtion += max( sm.x - sm.z, 0.0 );
        // a fresh explosion's fireball lights its smoke from inside
        emission = vec3( 1.0, 0.45, 0.15 ) * sm.y;

        // the fog is lit only by the sky / sun, but smoke is also lit by the lights around it
        // (lamps, torches, the muzzle flash): otherwise it's black indoors. One light sample
        // from each side, as if the cell were a surface facing the viewer and one facing away
        if( sm.z > 0.0 )
        {
            vec3 local = vec3( 0.0 );
            for( int side = 0; side < 2; side++ )
            {
                const vec3 n = side == 0 ? toviewer : -toviewer;

                Surface s;
                s.position        = center;
                s.instCustomIndex = 0;
                s.normalGeom      = n;
                s.roughness       = 1.0;
                s.normal          = n;
                s.albedo          = vec3( 1.0 );
                s.isSky           = false;
                s.specularColor   = vec3( 0.0 );
                s.emission        = 0.0;
                s.toViewerDir     = toviewer;

                const uint seed = getRandomSeed( ivec2( cell.x + cell.z, cell.y + 19 * cell.z + 7 * side ),
                                                 globalUniform.frameId );
                vec3 tolight = vec3( 0, 0, 1 );
                local += processDirectIllumination( seed, s, 0, tolight );
            }
            emission += local * sm.z;
        }
    }


#if ILLUMINATION_VOLUME
    imageStore( g_illuminationVolume, cell, vec4( radiance, 0.0 ) );
#endif
    imageStore( g_volumetric, cell, vec4( lighting * scattering + emission, scattering + absorbtion ) );
}
