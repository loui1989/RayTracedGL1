#version 460

#define DESC_SET_FRAMEBUFFERS 0
#define DESC_SET_GLOBAL_UNIFORM 1
#include "ShaderCommonGLSLFunc.h"

layout(local_size_x = COMPUTE_COMPOSE_GROUP_SIZE_X, local_size_y = COMPUTE_COMPOSE_GROUP_SIZE_Y, local_size_z = 1) in;

bool isLeftOutOfBounds(int checkerboardPix_X)
{
    return 
        checkerboardPix_X == 0 ||
        checkerboardPix_X == getCheckerboardSeparatorX(); 
}

bool isRightOutOfBounds(int checkerboardPix_X)
{
    return 
        checkerboardPix_X == getCheckerboardSeparatorX() ||
        checkerboardPix_X == int(globalUniform.renderWidth);
}

// Water / glass pixels alternate between the reflection and the refraction (a checkerboard).
// Each output is half its own kind and half the other kind, both smoothed over the 3x3
// neighbourhood: the 4 diagonal neighbours are the same kind as the center, the 4 side
// neighbours the other. Taking only the center for its own kind (as before) left a visible
// checkerboard where the reflection and refraction differ, which upscaling magnifies to grain.
vec3 resolveCheckerboard( sampler2D src, const ivec2 regularPix, const ivec2 checkerboardPix, const vec3 center )
{
    const bool leftOk  = !isLeftOutOfBounds( checkerboardPix.x );
    const bool rightOk = !isRightOutOfBounds( checkerboardPix.x );
    const bool upOk    = regularPix.y > 0;
    const bool downOk  = regularPix.y + 1 < int( globalUniform.renderHeight );

    vec3  other  = vec3( 0.0 );
    float otherW = 0.0;
    if( leftOk )  { other += texelFetch( src, regularPix + ivec2( -1,  0 ), 0 ).rgb; otherW += 1.0; }
    if( rightOk ) { other += texelFetch( src, regularPix + ivec2(  1,  0 ), 0 ).rgb; otherW += 1.0; }
    if( downOk )  { other += texelFetch( src, regularPix + ivec2(  0,  1 ), 0 ).rgb; otherW += 1.0; }
    if( upOk )    { other += texelFetch( src, regularPix + ivec2(  0, -1 ), 0 ).rgb; otherW += 1.0; }

    vec3  own  = center * 4.0;
    float ownW = 4.0;
    if( leftOk && upOk )     { own += texelFetch( src, regularPix + ivec2( -1, -1 ), 0 ).rgb; ownW += 1.0; }
    if( rightOk && upOk )    { own += texelFetch( src, regularPix + ivec2(  1, -1 ), 0 ).rgb; ownW += 1.0; }
    if( leftOk && downOk )   { own += texelFetch( src, regularPix + ivec2( -1,  1 ), 0 ).rgb; ownW += 1.0; }
    if( rightOk && downOk )  { own += texelFetch( src, regularPix + ivec2(  1,  1 ), 0 ).rgb; ownW += 1.0; }

    own /= ownW;
    return otherW > 0.0 ? 0.5 * own + 0.5 * ( other / otherW ) : center;
}

void main()
{
    const ivec2 pix             = ivec2( gl_GlobalInvocationID.x, gl_GlobalInvocationID.y );
    const ivec2 checkerboardPix = getCheckerboardPix( pix );

    if( pix.x >= uint( globalUniform.renderWidth ) || pix.y >= uint( globalUniform.renderHeight ) )
    {
        return;
    }

    vec3 hdr  = texelFetch( framebufPreFinal_Sampler, pix, 0 ).rgb;
    vec3 emis = texelFetch( framebufScreenEmisRT_Sampler, pix, 0 ).rgb;
    vec3 fog  = texelFetch( framebufAcidFogRT_Sampler, pix, 0 ).rgb;

    if( needResolveCheckerboard( checkerboardPix ) )
    {
        hdr  = resolveCheckerboard( framebufPreFinal_Sampler, pix, checkerboardPix, hdr );
        emis = resolveCheckerboard( framebufScreenEmisRT_Sampler, pix, checkerboardPix, emis );
        fog  = resolveCheckerboard( framebufAcidFogRT_Sampler, pix, checkerboardPix, fog );
    }

    imageStore( framebufFinal, pix, vec4( hdr, 0 ) );
    imageStore( framebufScreenEmission, pix, vec4( emis, 0 ) );
    imageStore( framebufAcidFog, pix, vec4( fog, 0 ) );
}